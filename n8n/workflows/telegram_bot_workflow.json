{
  "name": "Antigravity AI Bot Ultimate Master Ecosystem Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-ai-bot",
        "options": {}
      },
      "name": "1. Сообщение / Голосовая связь Telegram",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        700
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.extracted_event.is_event }}",
              "value2": true
            }
          ]
        }
      },
      "name": "2. Умный Маршрутизатор задач и команд",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        360,
        700
      ]
    },
    {
      "parameters": {
        "url": "https://generativelanguage.googleapis.com",
        "options": {}
      },
      "name": "3. Gemini 1.5 Pro AI Engine & STT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "mode",
              "value": "voice_or_text"
            }
          ]
        },
        "options": {}
      },
      "name": "4. Настройки меню и форматирование",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        720,
        900
      ]
    },
    {
      "parameters": {
        "url": "https://api.elevenlabs.io",
        "options": {}
      },
      "name": "5. Мульти-Голосовой Каскад (ElevenLabs/Azure/Google)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1080,
        100
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": "primary"
      },
      "name": "6. Google Календарь и Напоминания",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "antigravity_credentials",
          "name": "Antigravity Google OAuth2"
        }
      },
      "position": [
        1080,
        320
      ]
    },
    {
      "parameters": {
