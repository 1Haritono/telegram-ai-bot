{
  "name": "Antigravity AI Bot Full Ecosystem Architecture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-ai-bot",
        "options": {}
      },
      "name": "1. Сообщение / Голосовая связь Telegram",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        80,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.extracted_event.is_event }}",
              "value2": true
            }
          ]
        }
      },
      "name": "2. Маршрутизатор команд и сервисов",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        300,
        360
      ]
    },
    {
      "parameters": {
        "url": "https://generativelanguage.googleapis.com",
        "options": {}
      },
      "name": "3. Gemini AI & Распознавание речи STT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        520,
        180
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "mode",
              "value": "voice_or_text"
            }
          ]
        },
        "options": {}
      },
      "name": "4. Интерактивное меню и проверка режимов",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        520,
        500
      ]
    },
    {
      "parameters": {
        "url": "https://api.elevenlabs.io",
        "options": {}
      },
      "name": "5. Многофункциональный TTS (ElevenLabs / Azure / Google)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        740,
        180
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": "primary"
      },
      "name": "6. Google Календарь и Напоминания",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [
        740,
        340
      ]
    },
    {
      "parameters": {
        "url": "https://keep.googleapis.com",
        "options": {}
      },
      "name": "7. Google Keep (Заметки и Заметки-списки)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        740,
        500
      ]
    },
    {
      "parameters": {
        "url": "https://tasks.googleapis.com",
        "options": {}
      },
      "name": "8. Google Tasks (Менеджер задач)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        740,
        660
      ]
    },
    {
      "parameters": {
        "url": "https://people.googleapis.com",
        "options": {}
      },
      "name": "9. Google Contacts (Адресная книга)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        960,
        340
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        }
      },
      "name": "10. Google Sheets (Таблицы и Отчеты)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        960,
        500
      ]
    },
    {
      "parameters": {
        "url": "https://forms.googleapis.com",
        "options": {}
      },
      "name": "11. Google Forms (Опросы и Анкеты)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        960,
        660
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.body.user_id }}",
        "text": "={{ $json.text }}"
      },
      "name": "12. Telegram Отправить ответ (Голосовой / Текстовый)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        1200,
        420
      ]
    }
  ],
